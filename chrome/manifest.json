{
  "manifest_version": 3,
  "name": "ChatGPT Conversation to PDF",
  "version": "0.1.0",
  "description": "Export a ChatGPT conversation or selected chat text as a PDF.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Export ChatGPT conversation as PDF"
  }
}
